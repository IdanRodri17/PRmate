# ─────────────────────────────────────────────────────────────────────────
# PRmate environment variables — TEMPLATE
# ─────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# .env is gitignored; .env.example is committed.
#
# Each variable maps to a field in app/config.py Settings.
# ─────────────────────────────────────────────────────────────────────────

# ─── GitHub App credentials ──────────────────────────────────────────────
# Visible on your App's settings page at:
#   https://github.com/settings/apps/<your-app-name>
GITHUB_APP_ID=000000
GITHUB_CLIENT_ID=Iv00000000000000000

# Base64-encoded private key from the .pem file you downloaded.
# Generate with:
#   base64 -w0 secrets/your-app-private-key.pem
GITHUB_PRIVATE_KEY_B64=PUT_YOUR_BASE64_ENCODED_PRIVATE_KEY_HERE

# Webhook secret — must match what you set in the GitHub App settings.
# Generate a strong one with:
#   openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=PUT_YOUR_WEBHOOK_SECRET_HERE

# ─── Application runtime ─────────────────────────────────────────────────
# One of: development, production
ENVIRONMENT=development

# Local SQLite database for the LangGraph checkpointer (V1-V5).
# Swapped for PostgresSaver via DATABASE_URL in V6.
SQLITE_DB_PATH=data/prmate.db